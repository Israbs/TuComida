generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  ADMIN
  CASHIER
  COOK
  WAITER
}

enum SubscriptionPlan {
  STARTER
  GROWTH
  SCALE
}

model Subscription {
  id               String           @id @default(cuid())
  tenantId         String           @unique
  plan             SubscriptionPlan @default(STARTER)
  billingCycle     String           @default("monthly")
  status           String           @default("active")
  currentPeriodEnd DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Tenant {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  attendanceSecret String?
  orderCounter     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users        User[]
  categories   Category[]
  products     Product[]
  ingredients  Ingredient[]
  addons       Addon[]
  orders       Order[]
  tables       Table[]
  attendances  Attendance[]
  employees    Employee[]
  subscription Subscription?
}

model User {
  id                  String    @id @default(cuid())
  tenantId            String
  name                String
  email               String    @unique
  passwordHash        String?
  role                UserRole  @default(ADMIN)
  emailVerified       DateTime?
  image               String?
  inviteToken         String?   @unique
  inviteTokenExpiresAt DateTime?
  invitedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders              Order[]
  attendances         Attendance[]
  employee            Employee?

  @@unique([email, tenantId])
  @@index([tenantId])
}

model Category {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products    Product[]

  @@index([tenantId])
}

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  categoryId  String
  name        String
  description String?
  priceCents  Int      @default(0)
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  ingredients Ingredient[]
  addons      Addon[]

  @@index([tenantId])
  @@index([categoryId])
}

model Ingredient {
  id        String   @id @default(cuid())
  tenantId  String
  productId String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
}

model Addon {
  id         String   @id @default(cuid())
  tenantId   String
  productId  String
  name       String
  priceCents Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
}

model Employee {
  id              String    @id @default(cuid())
  tenantId        String
  userId          String?   @unique
  name            String
  email           String    @unique
  role            UserRole
  phone           String?
  photoUrl        String?
  idDocUrl        String?
  contractEnd     DateTime?
  hourlyRateCents Int       @default(0)
  startDate       DateTime?
  schedule        String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId])
}

model Table {
  id        String   @id @default(cuid())
  tenantId  String
  number    Int
  name      String?
  qrCode    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@unique([tenantId, number])
  @@index([tenantId])
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum OrderOrigin {
  POS
  ONLINE
  WAITER
}

model Order {
  id           String      @id @default(cuid())
  tenantId     String
  number       Int         @default(0)
  tableId      String?
  userId       String?
  customerName String?
  status       OrderStatus @default(PENDING)
  origin       OrderOrigin @default(POS)
  totalCents   Int         @default(0)
  notes        String?
  paidAt       DateTime?
  preparingAt  DateTime?
  readyAt      DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  table        Table?      @relation(fields: [tableId], references: [id])
  user         User?       @relation(fields: [userId], references: [id])
  items        OrderItem[]

  @@index([tenantId])
  @@index([status])
}

model OrderItem {
  id                 String   @id @default(cuid())
  orderId            String
  productId          String
  quantity           Int
  unitPriceCents     Int
  addons             Json?
  removedIngredients Json?
  notes              String?
  createdAt DateTime @default(now())

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model Attendance {
  id         String    @id @default(cuid())
  tenantId   String
  userId     String
  clockIn    DateTime
  clockOut   DateTime?
  hourlyRate Float
  source     String    @default("employee")
  adjustedBy String?
  adjustedAt DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId, clockIn])
}
