generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  ADMIN
  CASHIER
  COOK
  WAITER
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  categories   Category[]
  products     Product[]
  orders       Order[]
  tables       Table[]
  shifts       Shift[]
}

model User {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  email          String   @unique
  passwordHash   String
  role           UserRole @default(ADMIN)
  emailVerified  DateTime?
  image          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders         Order[]
  shifts         Shift[]

  @@unique([email, tenantId])
  @@index([tenantId])
}

model Category {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products    Product[]

  @@index([tenantId])
}

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  categoryId  String
  name        String
  description String?
  price       Float
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]

  @@index([tenantId])
  @@index([categoryId])
}

model Table {
  id        String   @id @default(cuid())
  tenantId  String
  number    Int
  name      String?
  qrCode    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@unique([tenantId, number])
  @@index([tenantId])
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum OrderOrigin {
  POS
  ONLINE
  WAITER
}

model Order {
  id           String      @id @default(cuid())
  tenantId     String
  tableId      String?
  userId       String?
  customerName String?
  status       OrderStatus @default(PENDING)
  origin       OrderOrigin @default(POS)
  total        Float
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  table        Table?      @relation(fields: [tableId], references: [id])
  user         User?       @relation(fields: [userId], references: [id])
  items        OrderItem[]

  @@index([tenantId])
  @@index([status])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Float
  notes     String?
  createdAt DateTime @default(now())

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model Shift {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  startTime  DateTime
  endTime    DateTime?
  hourlyRate Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
}
