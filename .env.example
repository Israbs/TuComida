# Base de datos (SQLite para desarrollo)
DATABASE_URL="file:./dev.db"

# Para PostgreSQL en producción:
# DATABASE_URL="postgresql://user:password@localhost:5432/tucomida"

# Secreto para JWT - generar con: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-secret"

# URL base de la aplicación
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Envío de invitaciones por correo (opcional). Si no se configura,
# el link de invitación se muestra en desarrollo.
RESEND_API_KEY=""
MAIL_FROM="TuComida <onboarding@resend.dev>"
